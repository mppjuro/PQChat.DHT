rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Academic Research Compressed Bundles (Master's Thesis ZIP Archives)
    // - Enforces anonymous / non-null authentication: request.auth != null
    // - Append-only: delete is strictly forbidden
    // - Privacy preservation: reading other research bundles is forbidden (read: if false)
    // - File validation: must end in .zip, must have contentType application/zip, max 15MB
    match /research_bundles/{sessionId}/{filename} {
      allow read: if false;
      allow delete: if false;
      allow write: if request.auth != null
        && filename.matches('.*\\.zip$')
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'application/zip';
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
