(* ============================================================================== *)
(* PQChat.DHT Protocol — Unified Formal Security Model (ProVerif 2.05)            *)
(*                                                                                *)
(* Verified Properties:                                                           *)
(* 1. Secrecy: MasterKey, ChainKey_A2B, ChainKey_B2A, Message Payloads           *)
(* 2. Authentication: Injective Agreement on Handshake & SAS                      *)
(* 3. Dual-Defense Hybrid KEM: ML-KEM-512 (FIPS 203) + X25519 (RFC 7748)          *)
(* 4. Replay Resistance: Injective message correspondences                        *)
(* 5. Safe Tombstone slot cleanup (900-byte CSPRNG noise overwrite)               *)
(* 6. Micro-Payload Authenticity & AAD Binding:                                   *)
(*    - Type 0x07: Message Reaction (emoji bound to targetSeqEpoch & targetSeqNum)*)
(*    - Type 0x08: Location Pin / Safety Status (coordinates & note)              *)
(*                                                                                *)
(* Cryptographic Primitives:                                                      *)
(* - Hybrid KEM: ML-KEM-512 IND-CCA2 + classical X25519 ECDH                       *)
(* - HKDF-SHA512 (RFC 5869) Key Derivation & Dual Unidirectional Chains           *)
(* - AES-256-GCM AEAD Authenticated Encryption with AAD Binding                   *)
(* - SHA-256 Anti-Grinding Commitment & 8-Digit SAS Derivation                   *)
(* - Ed25519 (BEP 44 Transport & Ephemeral Key Hopping Target Derivation)          *)
(* - 900-byte CSPRNG noise tombstone slot invalidation                            *)
(* ============================================================================== *)

type kem_skey.
type kem_pkey.
type kem_ct.
type x_skey.
type x_pkey.
type ed_skey.
type ed_pkey.

(* --- ML-KEM-512 Key Encapsulation Mechanism --- *)
fun kem_pk(kem_skey): kem_pkey.
fun kem_encap_ct(kem_pkey, bitstring): kem_ct.
fun kem_encap_ss(kem_pkey, bitstring): bitstring [private].
reduc forall sk: kem_skey, r: bitstring; kem_decap(sk, kem_encap_ct(kem_pk(sk), r)) = kem_encap_ss(kem_pk(sk), r).

(* --- Classical X25519 Ephemeral Key Agreement --- *)
fun x_pk(x_skey): x_pkey.
fun x_ecdh(x_skey, x_pkey): bitstring.
equation forall a: x_skey, b: x_skey; x_ecdh(a, x_pk(b)) = x_ecdh(b, x_pk(a)).

(* --- Hybrid Secret Combiner (HKDF-Extract(ssEcdh, ssKem)) --- *)
fun hybrid_combine(bitstring, bitstring): bitstring.

(* --- Ed25519 Ephemeral Signature & BEP 44 Token --- *)
fun ed_pk(ed_skey): ed_pkey.
fun ed_derive_sk(bitstring): ed_skey.
fun ed_sign(ed_skey, bitstring): bitstring.
reduc forall sk: ed_skey, m: bitstring; ed_verify(ed_pk(sk), m, ed_sign(sk, m)) = true.

(* --- Hash, HMAC, HKDF & Anti-Grinding Commitment --- *)
fun sha1(ed_pkey): bitstring.
fun sha256(bitstring): bitstring.
fun sha512(bitstring): bitstring.
fun hmac(bitstring, bitstring): bitstring.
fun hkdf_extract(bitstring, bitstring): bitstring.
fun hkdf_expand(bitstring, bitstring): bitstring.

fun get_msg_key(bitstring): bitstring.
fun get_ed_seed(bitstring): bitstring.
fun get_next_chain(bitstring): bitstring.

(* --- AEAD (AES-256-GCM) with AAD binding --- *)
fun aead_enc(bitstring, bitstring, bitstring, bitstring): bitstring.
reduc forall k: bitstring, iv: bitstring, pt: bitstring, aad: bitstring;
  aead_dec(k, iv, aead_enc(k, iv, pt, aad), aad) = pt.

(* --- Protocol String Constants & Labels --- *)
const TAG_RENDEZVOUS: bitstring.
const TAG_KEY_CONFIRM: bitstring.
const TAG_A2B: bitstring.
const TAG_B2A: bitstring.
const TAG_STEP_0: bitstring.
const TAG_STEP_1: bitstring.
const TAG_REKEY_STEP: bitstring.
const TAG_ANTIGRIND: bitstring.
const TAG_SAS: bitstring.
const MSG_TYPE_TXT: bitstring.
const MSG_TYPE_REKEY_OFFER: bitstring.
const MSG_TYPE_REKEY_RESP: bitstring.
const MSG_TYPE_REACTION: bitstring.
const MSG_TYPE_LOCATION_PIN: bitstring.

(* --- Channels --- *)
free c_dht: channel.             (* Public untrusted DHT transport (Dolev-Yao attacker) *)
free c_qr: channel [private].    (* Visual QR Code channel (Authentic out-of-band scan) *)

(* --- Secret Terms to Prove Confidential --- *)
free secret_master_key: bitstring [private].
free secret_chain_A2B: bitstring [private].
free secret_chain_B2A: bitstring [private].
free secret_msg_A2B: bitstring [private].
free secret_msg_B2A: bitstring [private].
free secret_reaction_emoji: bitstring [private].
free secret_location_pin: bitstring [private].

(* --- Correspondence Events for Authentication & Replay Protection --- *)
event AliceStarted(kem_pkey, x_pkey, bitstring).
event BobFinished(kem_pkey, x_pkey, bitstring, bitstring, bitstring, bitstring).
event AliceFinished(kem_pkey, x_pkey, bitstring, bitstring, bitstring, bitstring).
event AliceSentMsg(bitstring, bitstring, bitstring).
event BobRecvMsg(bitstring, bitstring, bitstring).
event BobSentReply(bitstring, bitstring, bitstring).
event AliceRecvReply(bitstring, bitstring, bitstring).
event AliceSentReaction(bitstring, bitstring, bitstring).
event BobRecvReaction(bitstring, bitstring, bitstring).
event BobSentLocationPin(bitstring, bitstring, bitstring).
event AliceRecvLocationPin(bitstring, bitstring, bitstring).

(* ============================================================================== *)
(* SECURITY QUERIES                                                               *)
(* ============================================================================== *)

(* (1) Secrecy: MasterKey, ChainKeys, Payloads, Micro-Payloads *)
query attacker(secret_master_key).
query attacker(secret_chain_A2B).
query attacker(secret_chain_B2A).
query attacker(secret_msg_A2B).
query attacker(secret_msg_B2A).
query attacker(secret_reaction_emoji).
query attacker(secret_location_pin).

(* (2) Mutual Authentication with Transcript & SAS Binding *)
query pkA_kem: kem_pkey, pkA_x: x_pkey, seed: bitstring, ckA2B: bitstring, ckB2A: bitstring, sas: bitstring;
  inj-event(AliceFinished(pkA_kem, pkA_x, seed, ckA2B, ckB2A, sas)) ==> 
  inj-event(BobFinished(pkA_kem, pkA_x, seed, ckA2B, ckB2A, sas)).

(* (3) Replay Resistance & AAD Authenticity: Injective message correspondences *)
query target: bitstring, seq: bitstring, msg: bitstring;
  inj-event(BobRecvMsg(target, seq, msg)) ==> inj-event(AliceSentMsg(target, seq, msg)).

query target: bitstring, seq: bitstring, msg: bitstring;
  inj-event(AliceRecvReply(target, seq, msg)) ==> inj-event(BobSentReply(target, seq, msg)).

(* (4) Micro-Payload Authenticity & AAD Binding (Type 0x07 Reaction & Type 0x08 Location Pin) *)
query target: bitstring, seq: bitstring, emoji: bitstring;
  inj-event(BobRecvReaction(target, seq, emoji)) ==> inj-event(AliceSentReaction(target, seq, emoji)).

query target: bitstring, seq: bitstring, loc: bitstring;
  inj-event(AliceRecvLocationPin(target, seq, loc)) ==> inj-event(BobSentLocationPin(target, seq, loc)).

(* ============================================================================== *)
(* PROTOCOL ROLES                                                                 *)
(* ============================================================================== *)

let processAlice =
  (* 1. Alice generates Hybrid keypair (ML-KEM-512 + X25519) and Seed_init *)
  new sk_kem_A: kem_skey;
  let pk_kem_A = kem_pk(sk_kem_A) in
  new sk_x_A: x_skey;
  let pk_x_A = x_pk(sk_x_A) in
  new seed_init: bitstring;
  event AliceStarted(pk_kem_A, pk_x_A, seed_init);
  
  (* 2. Alice presents authentic visual QR code (Combined pk || Seed_init) *)
  out(c_qr, (pk_kem_A, pk_x_A, seed_init));
  
  (* 3. Alice derives rendezvous Target_0 *)
  let target_0 = sha1(ed_pk(ed_derive_sk(hmac(seed_init, TAG_RENDEZVOUS)))) in
  
  (* 4. Alice receives Type 0x01 Handshake packet from DHT Target_0 *)
  in(c_dht, (=target_0, ct_kem_B: kem_ct, pk_x_B: x_pkey, salt: bitstring, confirm_tag: bitstring));
  
  (* 5. Alice decapsulates Hybrid KEM and derives secrets with transcript binding *)
  let ss_kem = kem_decap(sk_kem_A, ct_kem_B) in
  let ss_ecdh = x_ecdh(sk_x_A, pk_x_B) in
  let ss_hybrid = hybrid_combine(ss_ecdh, ss_kem) in
  let transcript = (pk_kem_A, pk_x_A, ct_kem_B, pk_x_B, seed_init, salt) in
  let commitment = sha256((TAG_ANTIGRIND, seed_init, transcript)) in
  let prk = hkdf_extract(salt, ss_hybrid) in
  let master_key = hkdf_expand(prk, sha512(transcript)) in
  let expected_tag = hkdf_expand(master_key, TAG_KEY_CONFIRM) in
  
  (* 6. Verify Key Confirmation & SAS *)
  if confirm_tag = expected_tag then
  let sas = hkdf_expand(master_key, (TAG_SAS, commitment)) in
  let chain_key_A2B = hkdf_expand(master_key, TAG_A2B) in
  let chain_key_B2A = hkdf_expand(master_key, TAG_B2A) in
  event AliceFinished(pk_kem_A, pk_x_A, seed_init, chain_key_A2B, chain_key_B2A, sas);
  
  (* 7. Alice initiates Track A -> B: Message 0 (Seq = 0) *)
  let seq_0 = TAG_STEP_0 in
  let entropy_0 = hkdf_expand(chain_key_A2B, seq_0) in
  let msg_key_0 = get_msg_key(entropy_0) in
  let ed_seed_0 = get_ed_seed(entropy_0) in
  let next_chain_A2B = get_next_chain(entropy_0) in
  let ed_sk_0 = ed_derive_sk(ed_seed_0) in
  let ed_pk_0 = ed_pk(ed_sk_0) in
  let target_1 = sha1(ed_pk_0) in
  
  new iv_0: bitstring;
  let aad_0 = (target_1, TAG_A2B) in
  let ciphertext_0 = aead_enc(msg_key_0, iv_0, secret_msg_A2B, aad_0) in
  let sig_0 = ed_sign(ed_sk_0, (target_1, ciphertext_0)) in
  
  event AliceSentMsg(target_1, seq_0, secret_msg_A2B);
  out(c_dht, (target_1, ciphertext_0, iv_0, sig_0));
  
  (* Canaries to test secrecy of derived keys *)
  new iv_canary_0: bitstring;
  new iv_canary_1: bitstring;
  new iv_canary_2: bitstring;
  out(c_dht, aead_enc(master_key, iv_canary_0, secret_master_key, TAG_KEY_CONFIRM));
  out(c_dht, aead_enc(chain_key_A2B, iv_canary_1, secret_chain_A2B, TAG_A2B));
  out(c_dht, aead_enc(chain_key_B2A, iv_canary_2, secret_chain_B2A, TAG_B2A));

  (* 8. Alice receives reply from Bob on Track B -> A *)
  let seq_B0 = TAG_STEP_0 in
  let entropy_B0 = hkdf_expand(chain_key_B2A, seq_B0) in
  let msg_key_B0 = get_msg_key(entropy_B0) in
  let ed_seed_B0 = get_ed_seed(entropy_B0) in
  let next_chain_B2A = get_next_chain(entropy_B0) in
  let ed_sk_B0 = ed_derive_sk(ed_seed_B0) in
  let ed_pk_B0 = ed_pk(ed_sk_B0) in
  let target_B1 = sha1(ed_pk_B0) in
  
  in(c_dht, (=target_B1, ciphertext_B0: bitstring, iv_B0: bitstring, sig_B0: bitstring));
  if ed_verify(ed_pk_B0, (target_B1, ciphertext_B0), sig_B0) = true then
  let aad_B0 = (target_B1, TAG_B2A) in
  let recv_reply = aead_dec(msg_key_B0, iv_B0, ciphertext_B0, aad_B0) in
  event AliceRecvReply(target_B1, seq_B0, recv_reply);
  
  (* Safe Tombstone Overwrite (900-byte CSPRNG noise) destroys consumed ciphertext *)
  new tombstone_noise_A: bitstring;
  out(c_dht, (target_B1, tombstone_noise_A));

  (* 9. Alice sends Type 0x07 Reaction on Track A -> B (Seq = 1) *)
  let seq_1 = TAG_STEP_1 in
  let entropy_1 = hkdf_expand(next_chain_A2B, seq_1) in
  let msg_key_1 = get_msg_key(entropy_1) in
  let ed_seed_1 = get_ed_seed(entropy_1) in
  let ed_sk_1 = ed_derive_sk(ed_seed_1) in
  let ed_pk_1 = ed_pk(ed_sk_1) in
  let target_2 = sha1(ed_pk_1) in
  
  new iv_1: bitstring;
  let aad_1 = (target_2, TAG_A2B) in
  let ciphertext_1 = aead_enc(msg_key_1, iv_1, (MSG_TYPE_REACTION, secret_reaction_emoji), aad_1) in
  let sig_1 = ed_sign(ed_sk_1, (target_2, ciphertext_1)) in
  event AliceSentReaction(target_2, seq_1, secret_reaction_emoji);
  out(c_dht, (target_2, ciphertext_1, iv_1, sig_1));

  (* 10. Alice receives Type 0x08 Location Pin from Bob on Track B -> A (Seq = 1) *)
  let seq_B1 = TAG_STEP_1 in
  let entropy_B1 = hkdf_expand(next_chain_B2A, seq_B1) in
  let msg_key_B1 = get_msg_key(entropy_B1) in
  let ed_seed_B1 = get_ed_seed(entropy_B1) in
  let ed_sk_B1 = ed_derive_sk(ed_seed_B1) in
  let ed_pk_B1 = ed_pk(ed_sk_B1) in
  let target_B2 = sha1(ed_pk_B1) in
  
  in(c_dht, (=target_B2, ciphertext_B1: bitstring, iv_B1: bitstring, sig_B1: bitstring));
  if ed_verify(ed_pk_B1, (target_B2, ciphertext_B1), sig_B1) = true then
  let aad_B1 = (target_B2, TAG_B2A) in
  let (=MSG_TYPE_LOCATION_PIN, recv_loc: bitstring) = aead_dec(msg_key_B1, iv_B1, ciphertext_B1, aad_B1) in
  event AliceRecvLocationPin(target_B2, seq_B1, recv_loc).

let processBob =
  (* 1. Bob scans QR code *)
  in(c_qr, (pk_kem_A: kem_pkey, pk_x_A: x_pkey, seed_init: bitstring));
  
  (* 2. Bob encapsulates Hybrid KEM shared secret *)
  new r_kem: bitstring;
  let ct_kem_B = kem_encap_ct(pk_kem_A, r_kem) in
  let ss_kem = kem_encap_ss(pk_kem_A, r_kem) in
  new sk_x_B: x_skey;
  let pk_x_B = x_pk(sk_x_B) in
  let ss_ecdh = x_ecdh(sk_x_B, pk_x_A) in
  let ss_hybrid = hybrid_combine(ss_ecdh, ss_kem) in
  
  new salt: bitstring;
  let transcript = (pk_kem_A, pk_x_A, ct_kem_B, pk_x_B, seed_init, salt) in
  let commitment = sha256((TAG_ANTIGRIND, seed_init, transcript)) in
  let prk = hkdf_extract(salt, ss_hybrid) in
  let master_key = hkdf_expand(prk, sha512(transcript)) in
  let confirm_tag = hkdf_expand(master_key, TAG_KEY_CONFIRM) in
  let sas = hkdf_expand(master_key, (TAG_SAS, commitment)) in
  
  (* 3. Bob derives dual chain keys and records completion *)
  let chain_key_A2B = hkdf_expand(master_key, TAG_A2B) in
  let chain_key_B2A = hkdf_expand(master_key, TAG_B2A) in
  event BobFinished(pk_kem_A, pk_x_A, seed_init, chain_key_A2B, chain_key_B2A, sas);

  (* 4. Bob publishes Handshake packet to Target_0 *)
  let target_0 = sha1(ed_pk(ed_derive_sk(hmac(seed_init, TAG_RENDEZVOUS)))) in
  out(c_dht, (target_0, ct_kem_B, pk_x_B, salt, confirm_tag));
  
  (* 5. Bob receives Message 0 on Track A -> B *)
  let seq_0 = TAG_STEP_0 in
  let entropy_0 = hkdf_expand(chain_key_A2B, seq_0) in
  let msg_key_0 = get_msg_key(entropy_0) in
  let ed_seed_0 = get_ed_seed(entropy_0) in
  let next_chain_A2B = get_next_chain(entropy_0) in
  let ed_sk_0 = ed_derive_sk(ed_seed_0) in
  let ed_pk_0 = ed_pk(ed_sk_0) in
  let target_1 = sha1(ed_pk_0) in
  
  in(c_dht, (=target_1, ciphertext_0: bitstring, iv_0: bitstring, sig_0: bitstring));
  if ed_verify(ed_pk_0, (target_1, ciphertext_0), sig_0) = true then
  let aad_0 = (target_1, TAG_A2B) in
  let recv_msg = aead_dec(msg_key_0, iv_0, ciphertext_0, aad_0) in
  event BobRecvMsg(target_1, seq_0, recv_msg);
  
  (* 6. Safe Tombstone Overwrite (900-byte CSPRNG noise) *)
  new tombstone_noise_B: bitstring;
  out(c_dht, (target_1, tombstone_noise_B));
  
  (* 7. Bob sends reply Message 0 on Track B -> A *)
  let seq_B0 = TAG_STEP_0 in
  let entropy_B0 = hkdf_expand(chain_key_B2A, seq_B0) in
  let msg_key_B0 = get_msg_key(entropy_B0) in
  let ed_seed_B0 = get_ed_seed(entropy_B0) in
  let next_chain_B2A = get_next_chain(entropy_B0) in
  let ed_sk_B0 = ed_derive_sk(ed_seed_B0) in
  let ed_pk_B0 = ed_pk(ed_sk_B0) in
  let target_B1 = sha1(ed_pk_B0) in
  new iv_B0: bitstring;
  let aad_B0 = (target_B1, TAG_B2A) in
  let ciphertext_B0 = aead_enc(msg_key_B0, iv_B0, secret_msg_B2A, aad_B0) in
  let sig_B0 = ed_sign(ed_sk_B0, (target_B1, ciphertext_B0)) in
  event BobSentReply(target_B1, seq_B0, secret_msg_B2A);
  out(c_dht, (target_B1, ciphertext_B0, iv_B0, sig_B0));

  (* 8. Bob receives Type 0x07 Reaction on Track A -> B (Seq = 1) *)
  let seq_1 = TAG_STEP_1 in
  let entropy_1 = hkdf_expand(next_chain_A2B, seq_1) in
  let msg_key_1 = get_msg_key(entropy_1) in
  let ed_seed_1 = get_ed_seed(entropy_1) in
  let ed_sk_1 = ed_derive_sk(ed_seed_1) in
  let ed_pk_1 = ed_pk(ed_sk_1) in
  let target_2 = sha1(ed_pk_1) in
  
  in(c_dht, (=target_2, ciphertext_1: bitstring, iv_1: bitstring, sig_1: bitstring));
  if ed_verify(ed_pk_1, (target_2, ciphertext_1), sig_1) = true then
  let aad_1 = (target_2, TAG_A2B) in
  let (=MSG_TYPE_REACTION, recv_emoji: bitstring) = aead_dec(msg_key_1, iv_1, ciphertext_1, aad_1) in
  event BobRecvReaction(target_2, seq_1, recv_emoji);

  (* 9. Bob sends Type 0x08 Location Pin on Track B -> A (Seq = 1) *)
  let seq_B1 = TAG_STEP_1 in
  let entropy_B1 = hkdf_expand(next_chain_B2A, seq_B1) in
  let msg_key_B1 = get_msg_key(entropy_B1) in
  let ed_seed_B1 = get_ed_seed(entropy_B1) in
  let ed_sk_B1 = ed_derive_sk(ed_seed_B1) in
  let ed_pk_B1 = ed_pk(ed_sk_B1) in
  let target_B2 = sha1(ed_pk_B1) in
  new iv_B1: bitstring;
  let aad_B1 = (target_B2, TAG_B2A) in
  let ciphertext_B1 = aead_enc(msg_key_B1, iv_B1, (MSG_TYPE_LOCATION_PIN, secret_location_pin), aad_B1) in
  let sig_B1 = ed_sign(ed_sk_B1, (target_B2, ciphertext_B1)) in
  event BobSentLocationPin(target_B2, seq_B1, secret_location_pin);
  out(c_dht, (target_B2, ciphertext_B1, iv_B1, sig_B1)).

process
  (!processAlice) | (!processBob)
