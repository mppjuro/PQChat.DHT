(* ==================================================================== *)
(* PQChat.DHT Protocol Formal Verification: (d) Target Unlinkability     *)
(* and 900-byte Tombstone / Cover Traffic Indistinguishability           *)
(*                                                                      *)
(* Proves via ProVerif Observational Equivalence (Diff-Equivalence):     *)
(* 1. Ephemeral key hopping targets Target_i = SHA-1(pk_i) cannot be    *)
(*    linked to communicating identities (Metadata-Free Rendezvous).    *)
(* 2. A 900-byte safe tombstone overwrite is indistinguishable from      *)
(*    a valid ciphertext frame and cover traffic dummy (PRP/Noise).      *)
(* ==================================================================== *)

type id_t.
type ed_skey.
type ed_pkey.
type frame_t.

(* --- Ed25519 Ephemeral Signature & Key Derivation --- *)
fun ed_pk(ed_skey): ed_pkey.
fun ed_derive_sk(bitstring): ed_skey.

(* --- Cryptographic Hash & KDF --- *)
fun sha1(ed_pkey): bitstring.
fun hkdf_expand(bitstring, bitstring): bitstring.
fun get_ed_seed(bitstring): bitstring.
fun get_next_chain(bitstring): bitstring.

(* --- Frame Representations (900 Bytes Constant Size) --- *)
fun enc_frame(bitstring, bitstring, bitstring): frame_t.
fun tombstone_frame(bitstring): frame_t.
fun cover_frame(bitstring): frame_t.

(* --- Protocol Constants --- *)
const TAG_STEP_0: bitstring.
const TAG_STEP_1: bitstring.

(* --- Channels --- *)
free c_pub: channel.             (* Public DHT network *)

(* --- Identities --- *)
free Alice: id_t.
free Bob: id_t.
free Charlie: id_t.
free Dave: id_t.

(* ==================================================================== *)
(* Observational Equivalence Process:                                   *)
(* 1. Target emitted in Session(Alice, Bob) vs Session(Charlie, Dave)   *)
(* 2. Frame emitted: Valid Ciphertext vs 900-byte Safe Tombstone vs Dummy*)
(* ==================================================================== *)

process
  (* Session 1: Alice & Bob share private chain key *)
  new chain_key_AB: bitstring;
  
  (* Session 2: Charlie & Dave share independent private chain key *)
  new chain_key_CD: bitstring;
  
  (* Step 0: Target derivation for Session AB *)
  let entropy_AB_0 = hkdf_expand(chain_key_AB, TAG_STEP_0) in
  let ed_seed_AB_0 = get_ed_seed(entropy_AB_0) in
  let target_AB_0 = sha1(ed_pk(ed_derive_sk(ed_seed_AB_0))) in
  let next_chain_AB = get_next_chain(entropy_AB_0) in
  
  (* Step 0: Target derivation for Session CD *)
  let entropy_CD_0 = hkdf_expand(chain_key_CD, TAG_STEP_0) in
  let ed_seed_CD_0 = get_ed_seed(entropy_CD_0) in
  let target_CD_0 = sha1(ed_pk(ed_derive_sk(ed_seed_CD_0))) in
  let next_chain_CD = get_next_chain(entropy_CD_0) in
  
  (* Step 1: Subsequent target derivation for Session AB *)
  let entropy_AB_1 = hkdf_expand(next_chain_AB, TAG_STEP_1) in
  let ed_seed_AB_1 = get_ed_seed(entropy_AB_1) in
  let target_AB_1 = sha1(ed_pk(ed_derive_sk(ed_seed_AB_1))) in
  
  (* Step 1: Subsequent target derivation for Session CD *)
  let entropy_CD_1 = hkdf_expand(next_chain_CD, TAG_STEP_1) in
  let ed_seed_CD_1 = get_ed_seed(entropy_CD_1) in
  let target_CD_1 = sha1(ed_pk(ed_derive_sk(ed_seed_CD_1))) in
  
  (* Attacker knows participants' identities Alice, Bob, Charlie, Dave *)
  out(c_pub, (Alice, Bob, Charlie, Dave));
  
  (* Public DHT observer sees targets emitted by choice[Session_AB, Session_CD] *)
  out(c_pub, choice[target_AB_0, target_CD_0]);
  out(c_pub, choice[target_AB_1, target_CD_1]);

  (* Indistinguishability of 900-byte Tombstone vs Encrypted Frame & Cover Traffic *)
  new k_payload: bitstring;
  new iv_frame: bitstring;
  new secret_payload: bitstring;
  new r_tombstone: bitstring;
  new r_cover: bitstring;
  
  let valid_frame = enc_frame(k_payload, iv_frame, secret_payload) in
  let tombstone_slot = tombstone_frame(r_tombstone) in
  let cover_slot = cover_frame(r_cover) in
  
  out(c_pub, choice[valid_frame, tombstone_slot]);
  out(c_pub, choice[tombstone_slot, cover_slot])
