rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Academic Research Sessions (Master's Thesis Anonymous Telemetry)
    // - Enforces anonymous / non-null authentication: request.auth != null
    // - Local-First Batch Archiving: only session-level summary documents are written
    // - Append-only: delete is strictly forbidden
    // - Privacy preservation: reading other sessions is forbidden (read: if false)
    match /research_sessions/{sessionId} {
      allow read: if false;
      allow delete: if false;
      allow create, update: if request.auth != null
        && request.resource.data.sessionId == sessionId
        && request.resource.data.totalEvents is int
        && request.resource.data.manifestSha256 is string;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
